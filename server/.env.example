# Powhunter server configuration.
#
# Every variable the code actually reads is listed here. Previous versions of
# this file documented DATABASE_URL and a set of SMTP_* variables that nothing
# in the codebase ever read, so anyone following it got the built-in defaults
# instead of their own settings.

# Environment: "production" enables strict configuration checks, HSTS, and TLS
# for the database connection.
ENVIRONMENT=development

# HTTP
PORT=8080

# Comma-separated list of browser origins allowed to call the API.
# A wildcard is rejected in production. Credentials are never sent with one.
ALLOWED_ORIGINS=http://localhost:3000

# Set when the API runs behind a reverse proxy such as Caddy, so client
# addresses are read from forwarding headers. Leave unset otherwise: trusting
# these headers without a proxy lets any caller spoof its address and bypass
# rate limiting. Defaults to true in production.
# TRUST_PROXY_HEADERS=true

# Request limits
# MAX_BODY_BYTES=65536
# RATE_LIMIT_PER_SECOND=10
# RATE_LIMIT_BURST=20
# WRITE_RATE_LIMIT_PER_SECOND=1
# WRITE_RATE_LIMIT_BURST=5

# Database. DB_USER and DB_PASSWORD are required in production; the server
# refuses to start without them rather than falling back to a default
# credential.
DB_HOST=localhost
DB_PORT=5432
DB_USER=powhunter_rw
DB_PASSWORD=change_me
DB_NAME=powhunter
# Defaults to "disable" in development and "require" in production.
# DB_SSLMODE=require

# Twilio, used by the forecaster to send SMS alerts. All three are required;
# the forecaster refuses to run without them.
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Resend, used by the contact form. If unset, the form still succeeds and the
# message is only written to the contact log.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are appended. This file holds names, email
# addresses and message bodies, so put it somewhere with restricted permissions
# and log rotation rather than leaving it in /tmp.
# CONTACT_LOG_PATH=/var/log/powhunter/contacts.log

# Pushgateway for forecaster run metrics. Without it, a forecaster that stops
# running is invisible.
# PUSHGATEWAY_URL=http://localhost:9091

# Test database, used by the integration suite. Set POWHUNTER_TEST_DB to make an
# unreachable database a failure rather than a skip; CI sets it.
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=postgres
# TEST_DB_NAME=powhunter_test
# POWHUNTER_TEST_DB=1
